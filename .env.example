# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="https://ais-dev-lsfjpostansuaavm5ye47r-56265293443.asia-northeast1.run.app"

# DATABASE (Supabase PostgreSQL / Cloud SQL)
# Configure when transitioning from client-persistent storage to live backend database:
